# =============================================================================
# RADIUS Manager — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores antes de subir os containers
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=radius
POSTGRES_USER=radius
POSTGRES_PASSWORD=radiuspassword

# -----------------------------------------------------------------------------
# Aplicação Web (Flask)
# -----------------------------------------------------------------------------
# Gere uma chave aleatória: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ad65d4365d463d4w65fw65f6834t6q8w34rw1rf6w

# -----------------------------------------------------------------------------
# Integração SGP (ERP)
# -----------------------------------------------------------------------------
SGP_URL=https://linknetam.sgp.net.br/api/ura/consultacliente/
SGP_TOKEN=74b3dfe5-8333-458a-adab-ea2b544d64ad
SGP_APP=APP

# -----------------------------------------------------------------------------
# Sincronização automática
# Intervalo em segundos entre cada ciclo de sync (padrão: 300 = 5 minutos)
# -----------------------------------------------------------------------------
SYNC_INTERVAL=300
# Timeout máximo do ciclo de sync em segundos (padrão: 600 = 10 min)
SYNC_MAX_DURATION=600
# Alertas de cliente offline: dias sem conexão para notificar (0 = desativado)
OFFLINE_ALERT_DAYS=0

# -----------------------------------------------------------------------------
# Notificações por e-mail (SMTP) — opcional
# Deixe SMTP_HOST vazio para desativar notificações por e-mail
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# WireGuard Server (para MikroTiks de outras cidades)
# -----------------------------------------------------------------------------

# IP público ou domínio deste servidor — usado nos arquivos de config dos peers
# Em ambiente sem IP público, deixe vazio ou coloque o IP local
WG_HOST=

# Porta UDP do WireGuard (padrão deste projeto: 47320 — fora do padrão 51820)
WG_UDP_PORT=47320

# Hash da senha da interface web do WireGuard (porta 47321)
# Gere com: docker run --rm ghcr.io/wg-easy/wg-easy wgpw 'SUA_SENHA_AQUI'
# Cole o hash resultante abaixo (com as aspas simples escapadas se necessário)
WG_PASSWORD_HASH=$$2a$$12$$troque-pelo-hash-gerado-acima

# -----------------------------------------------------------------------------
# Encaminhamento de Accounting ao SGP (clientes online no SGP)
# Documentação completa: docs/SGP_ACCOUNTING.md
# -----------------------------------------------------------------------------

# Ativa/desativa o encaminhamento de accounting ao SGP (true/false)
SGP_RADIUS_ENABLED=true

# IP do servidor RADIUS do SGP (na rede L2TP)
SGP_RADIUS_HOST=172.16.116.1

# Porta de accounting do SGP
SGP_RADIUS_ACCT_PORT=2052

# Secret compartilhado com o RADIUS do SGP
SGP_RADIUS_SECRET=sgp@radius

# Mapeamento de NAS-IP: IP_WireGuard=IP_NAS_SGP (separados por vírgula)
# O IP WireGuard é o IP do MikroTik no túnel WG (10.73.91.x)
# O IP NAS SGP é o "Endereço IP" do NAS cadastrado no SGP (172.16.117.x)
# Exemplo com 3 MikroTiks:
#   SGP_NAS_IP_MAP=10.73.91.5=172.16.117.12,10.73.91.2=172.16.117.13,10.73.91.3=172.16.117.14
SGP_NAS_IP_MAP=10.73.91.5=172.16.117.12

# Fallback: NAS-IP usado quando o MikroTik não está no mapa acima
SGP_NAS_IP_OVERRIDE=172.16.117.12

# Mapeamento de Nome Identificador: IP_WireGuard=NomeNoSGP (separados por vírgula)
# Cada NAS no SGP tem um "Nome Identificador" diferente.
# Use o mesmo IP WireGuard da esquerda do SGP_NAS_IP_MAP.
# Exemplo com 3 MikroTiks:
#   SGP_NAS_ID_MAP=10.73.91.5=ONDELINE_NET,10.73.91.2=EIRUNEPE_NET,10.73.91.3=ITAMARATI_NET
SGP_NAS_ID_MAP=10.73.91.5=ONDELINE_NET

# Fallback: Nome usado quando o MikroTik não está no mapa acima (ou deixe vazio)
SGP_NAS_IDENTIFIER=ONDELINE_NET

# Debug: "true" loga cada pacote de accounting nos logs do FreeRADIUS
SGP_ACCT_DEBUG=false

# Chaves públicas WireGuard dos MikroTiks que têm VPN L2TP com o SGP
# Separadas por vírgula. Descubra com: docker exec radius_route_sgp sh -c "wg show wg0 allowed-ips"
# Exemplo com 3 MikroTiks:
#   SGP_WG_PEER_KEYS=chave1,chave2,chave3
SGP_WG_PEER_KEYS=T0IU0nE43dYEtcf+6IvBTVLy4UP5NFXxIglas4UblT0=

# -----------------------------------------------------------------------------
# NOC — Limiares de alertas operacionais
# -----------------------------------------------------------------------------
NOC_CHURN_WARN_PCT=5
NOC_CHURN_CRIT_PCT=12
NOC_AAA_WARN_PCT=2
NOC_AAA_CRIT_PCT=8

# -----------------------------------------------------------------------------
# GenieACS — ACS para gerência remota de CPEs via TR-069
# -----------------------------------------------------------------------------

# URL da NBI (North Bound Interface) do GenieACS — API REST consumida pelo SGP
# Em Docker Compose o hostname é genieacs-nbi (nome do serviço)
GENIEACS_NBI_URL=http://genieacs-nbi:7557

# Porta CWMP — endereço que os CPEs devem usar para se conectar ao ACS
# Configure nos CPEs/ONUs como: http://<IP_DO_SERVIDOR>:7547
# GENIEACS_CWMP_PORT=7547   # já definido no docker-compose, não precisa alterar

# Painel web do GenieACS (acesso técnico, porta 3001)
# Acesse: http://<IP_DO_SERVIDOR>:3001
# Usuário padrão: admin / senha: genieacs (altere após o primeiro acesso)
# GENIEACS_UI_PORT=3000     # já definido no docker-compose, não precisa alterar

# Intervalo de polling de CPEs em segundos (padrão: 60)
CPE_POLL_INTERVAL=60

# -----------------------------------------------------------------------------
# Alertas Telegram
# Configure no painel web em: Configurações → Alertas
# Ou insira diretamente no banco:
#   UPDATE alertas_config SET valor='true' WHERE chave='telegram_enabled';
#   UPDATE alertas_config SET valor='SEU_TOKEN' WHERE chave='telegram_bot_token';
#   UPDATE alertas_config SET valor='SEU_CHAT_ID' WHERE chave='telegram_chat_id';
# -----------------------------------------------------------------------------
# Para criar o bot: fale com @BotFather no Telegram → /newbot
# Para descobrir o chat_id: adicione @userinfobot ao grupo ou canal

# -----------------------------------------------------------------------------
# Grafana — Dashboards operacionais (porta 3002)
# Acesse: http://<IP_DO_SERVIDOR>:3002
# -----------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=troque-esta-senha

# Prometheus — coleta métricas (porta 9090)
# Acesse: http://<IP_DO_SERVIDOR>:9090
