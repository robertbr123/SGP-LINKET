# =============================================================================
# RADIUS Manager — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores antes de subir os containers
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=radius
POSTGRES_USER=radius
POSTGRES_PASSWORD=radiuspassword

# -----------------------------------------------------------------------------
# Aplicação Web (Flask)
# -----------------------------------------------------------------------------
# Gere uma chave aleatória: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ad65d4365d463d4w65fw65f6834t6q8w34rw1rf6w

# -----------------------------------------------------------------------------
# Integração SGP (ERP Linknet AM)
# -----------------------------------------------------------------------------
SGP_URL=https://linknetam.sgp.net.br/api/ura/consultacliente/
SGP_TOKEN=74b3dfe5-8333-458a-adab-ea2b544d64ad
SGP_APP=APP

# -----------------------------------------------------------------------------
# Sincronização automática
# Intervalo em segundos entre cada ciclo de sync (padrão: 300 = 5 minutos)
# -----------------------------------------------------------------------------
SYNC_INTERVAL=300

# -----------------------------------------------------------------------------
# Notificações por e-mail (SMTP) — opcional
# Deixe SMTP_HOST vazio para desativar notificações por e-mail
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
