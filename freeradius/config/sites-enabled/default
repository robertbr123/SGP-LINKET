server default {
    listen {
        type = auth
        ipaddr = *
        port = 1812
    }

    listen {
        type = acct
        ipaddr = *
        port = 1813
    }

    authorize {
        filter_username
        preprocess
        chap
        mschap
        suffix
        sql
        if (notfound) {
            update control {
                &Response-Packet-Type := Do-Not-Respond
            }
            handled
        }
        expiration
        logintime
        pap
    }

    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type mschap {
            mschap
        }
        Auth-Type MS-CHAP {
            mschap
        }
    }

    preacct {
        preprocess
        suffix
        files
    }

    accounting {
        # Encaminha cópia do accounting ao servidor RADIUS do SGP (tempo real)
        # Deve ficar ANTES do sql para não ser bloqueado por lentidão do banco
        exec_sgp_acct
        sql
        exec
        attr_filter.accounting_response
    }

    session {
        sql
    }

    post-auth {
        update reply {
            &User-Name !* ANY
        }
        # Intervalo de Interim-Update (em segundos).
        # Faz o MikroTik enviar Accounting Interim-Update periodicamente,
        # permitindo que o SGP mantenha a contagem de sessões online por NAS.
        update reply {
            &Acct-Interim-Interval := 300
        }
        sql
        exec
        remove_reply_message_if_eap
        Post-Auth-Type REJECT {
            attr_filter.access_reject
            update reply {
                &Reply-Message :=  "Acesso negado. Verifique seu contrato."
            }
            -sql
        }
    }

    pre-proxy {}
    post-proxy {}
}
