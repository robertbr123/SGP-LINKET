{
  "title": "SGP-LINKET — NAS / MikroTik",
  "uid": "sgp-nas",
  "schemaVersion": 38,
  "refresh": "15s",
  "time": {"from": "now-3h", "to": "now"},
  "tags": ["sgp", "mikrotik", "nas"],
  "style": "dark",
  "templating": {
    "list": [
      {
        "name": "nas",
        "type": "query",
        "label": "NAS",
        "datasource": {"type":"prometheus","uid":"prometheus"},
        "definition": "label_values(sgp_nas_up, nas)",
        "query": {"query":"label_values(sgp_nas_up, nas)","refId":"A"},
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1
      },
      {
        "name": "iface",
        "type": "query",
        "label": "Interface WAN",
        "datasource": {"type":"prometheus","uid":"prometheus"},
        "definition": "label_values(sgp_nas_iface_rx_bytes{nas=\"$nas\"}, iface)",
        "query": {"query":"label_values(sgp_nas_iface_rx_bytes{nas=\"$nas\"}, iface)","refId":"B"},
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1
      }
    ]
  },
  "panels": [

    { "id":1, "type":"row", "title":"⚡ Download / Upload em Tempo Real", "gridPos":{"x":0,"y":0,"w":24,"h":1}, "collapsed":false },

    {
      "id":2, "type":"stat", "title":"⬇ Download Atual",
      "description":"Taxa de recepção na interface selecionada",
      "gridPos":{"x":0,"y":1,"w":6,"h":5},
      "datasource":{"type":"prometheus","uid":"prometheus"},
      "targets":[{"expr":"rate(sgp_nas_iface_rx_bytes{nas=\"$nas\",iface=\"$iface\"}[1m])","legendFormat":"Download"}],
      "options":{
        "colorMode":"background","graphMode":"area","textMode":"value_and_name",
        "reduceOptions":{"calcs":["lastNotNull"]},
        "text":{"valueSize":38}
      },
      "fieldConfig":{
        "defaults":{
          "color":{"mode":"fixed","fixedColor":"#73BF69"},
          "unit":"Bps",
          "decimals":1,
          "thresholds":{"mode":"absolute","steps":[{"color":"#73BF69","value":0}]}
        }
      }
    },
    {
      "id":3, "type":"stat", "title":"⬆ Upload Atual",
      "description":"Taxa de transmissão na interface selecionada",
      "gridPos":{"x":6,"y":1,"w":6,"h":5},
      "datasource":{"type":"prometheus","uid":"prometheus"},
      "targets":[{"expr":"rate(sgp_nas_iface_tx_bytes{nas=\"$nas\",iface=\"$iface\"}[1m])","legendFormat":"Upload"}],
      "options":{
        "colorMode":"background","graphMode":"area","textMode":"value_and_name",
        "reduceOptions":{"calcs":["lastNotNull"]},
        "text":{"valueSize":38}
      },
      "fieldConfig":{
        "defaults":{
          "color":{"mode":"fixed","fixedColor":"#FF9830"},
          "unit":"Bps",
          "decimals":1,
          "thresholds":{"mode":"absolute","steps":[{"color":"#FF9830","value":0}]}
        }
      }
    },
    {
      "id":4, "type":"stat", "title":"Interface Status",
      "gridPos":{"x":12,"y":1,"w":3,"h":5},
      "datasource":{"type":"prometheus","uid":"prometheus"},
      "targets":[{"expr":"sgp_nas_iface_up{nas=\"$nas\",iface=\"$iface\"}","legendFormat":""}],
      "options":{
        "colorMode":"background","textMode":"value",
        "reduceOptions":{"calcs":["lastNotNull"]},
        "text":{"valueSize":32}
      },
      "fieldConfig":{
        "defaults":{
          "color":{"mode":"thresholds"},
          "thresholds":{"mode":"absolute","steps":[{"color":"red","value":0},{"color":"green","value":1}]},
          "mappings":[{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}]
        }
      }
    },
    {
      "id":5, "type":"stat", "title":"NAS Online",
      "gridPos":{"x":15,"y":1,"w":3,"h":5},
      "datasource":{"type":"prometheus","uid":"prometheus"},
      "targets":[{"expr":"sgp_nas_up{nas=\"$nas\"}","legendFormat":""}],
      "options":{
        "colorMode":"background","textMode":"value",
        "reduceOptions":{"calcs":["lastNotNull"]},
        "text":{"valueSize":32}
      },
      "fieldConfig":{
        "defaults":{
          "color":{"mode":"thresholds"},
          "thresholds":{"mode":"absolute","steps":[{"color":"red","value":0},{"color":"green","value":1}]},
          "mappings":[{"type":"value","options":{"0":{"text":"OFFLINE","color":"red"},"1":{"text":"ONLINE","color":"green"}}}]
        }
      }
    },
    {
      "id":6, "type":"stat", "title":"PPP Ativos",
      "gridPos":{"x":18,"y":1,"w":3,"h":5},
      "datasource":{"type":"prometheus","uid":"prometheus"},
      "targets":[{"expr":"sgp_nas_ppp_active{nas=\"$nas\"}","legendFormat":""}],
      "options":{
        "colorMode":"background","graphMode":"area","textMode":"value",
        "reduceOptions":{"calcs":["lastNotNull"]},
        "text":{"valueSize":32}
      },
      "fieldConfig":{
        "defaults":{"color":{"mode":"fixed","fixedColor":"#5794F2"},"unit":"short"}
      }
    },
    {
      "id":7, "type":"stat", "title":"CPU %",
      "gridPos":{"x":21,"y":1,"w":3,"h":5},
      "datasource":{"type":"prometheus","uid":"prometheus"},
      "targets":[{"expr":"sgp_nas_cpu_pct{nas=\"$nas\"}","legendFormat":"CPU"}],
      "options":{
        "colorMode":"background","graphMode":"area","textMode":"value",
        "reduceOptions":{"calcs":["lastNotNull"]},
        "text":{"valueSize":32}
      },
      "fieldConfig":{
        "defaults":{
          "color":{"mode":"thresholds"},"unit":"percent","min":0,"max":100,
          "thresholds":{"mode":"absolute","steps":[{"color":"green","value":0},{"color":"yellow","value":70},{"color":"red","value":90}]}
        }
      }
    },

    {
      "id":20, "type":"timeseries", "title":"📊 Velocidade — Download / Upload",
      "description":"Taxa de tráfego na interface $iface",
      "gridPos":{"x":0,"y":6,"w":24,"h":10},
      "datasource":{"type":"prometheus","uid":"prometheus"},
      "targets":[
        {"expr":"rate(sgp_nas_iface_rx_bytes{nas=\"$nas\",iface=\"$iface\"}[1m])","legendFormat":"⬇ Download"},
        {"expr":"rate(sgp_nas_iface_tx_bytes{nas=\"$nas\",iface=\"$iface\"}[1m])","legendFormat":"⬆ Upload"}
      ],
      "fieldConfig":{
        "defaults":{
          "custom":{"fillOpacity":25,"lineWidth":3,"spanNulls":true,"gradientMode":"opacity"},
          "unit":"Bps"
        },
        "overrides":[
          {"matcher":{"id":"byName","options":"⬇ Download"},"properties":[{"id":"color","value":{"mode":"fixed","fixedColor":"#73BF69"}}]},
          {"matcher":{"id":"byName","options":"⬆ Upload"},"properties":[{"id":"color","value":{"mode":"fixed","fixedColor":"#FF9830"}}]}
        ]
      },
      "options":{
        "tooltip":{"mode":"multi","sort":"desc"},
        "legend":{"displayMode":"table","placement":"bottom","calcs":["mean","max","lastNotNull"]},
        "fillBelowTo":"⬆ Upload"
      }
    },

    { "id":10, "type":"row", "title":"🔗 DHCP — Clientes na Rede", "gridPos":{"x":0,"y":16,"w":24,"h":1}, "collapsed":false },

    {
      "id":11, "type":"stat", "title":"✅ DHCP Ativos (Bound)",
      "gridPos":{"x":0,"y":17,"w":6,"h":5},
      "datasource":{"type":"prometheus","uid":"prometheus"},
      "targets":[{"expr":"sgp_nas_dhcp_active{nas=\"$nas\"}","legendFormat":"Ativos"}],
      "options":{
        "colorMode":"background","graphMode":"area","textMode":"value_and_name",
        "reduceOptions":{"calcs":["lastNotNull"]},
        "text":{"valueSize":42}
      },
      "fieldConfig":{
        "defaults":{
          "color":{"mode":"thresholds"},"unit":"short",
          "thresholds":{"mode":"absolute","steps":[{"color":"green","value":0}]}
        }
      }
    },
    {
      "id":12, "type":"stat", "title":"⏳ Aguardando (Waiting)",
      "gridPos":{"x":6,"y":17,"w":6,"h":5},
      "datasource":{"type":"prometheus","uid":"prometheus"},
      "targets":[{"expr":"sgp_nas_dhcp_waiting{nas=\"$nas\"}","legendFormat":"Aguardando"}],
      "options":{
        "colorMode":"background","graphMode":"area","textMode":"value_and_name",
        "reduceOptions":{"calcs":["lastNotNull"]},
        "text":{"valueSize":42}
      },
      "fieldConfig":{
        "defaults":{
          "color":{"mode":"thresholds"},"unit":"short",
          "thresholds":{"mode":"absolute","steps":[{"color":"green","value":0},{"color":"orange","value":1}]}
        }
      }
    },
    {
      "id":13, "type":"stat", "title":"📋 Total de Leases",
      "gridPos":{"x":12,"y":17,"w":6,"h":5},
      "datasource":{"type":"prometheus","uid":"prometheus"},
      "targets":[{"expr":"sgp_nas_dhcp_total{nas=\"$nas\"}","legendFormat":"Total"}],
      "options":{
        "colorMode":"background","graphMode":"area","textMode":"value_and_name",
        "reduceOptions":{"calcs":["lastNotNull"]},
        "text":{"valueSize":42}
      },
      "fieldConfig":{
        "defaults":{"color":{"mode":"fixed","fixedColor":"#5794F2"},"unit":"short"}
      }
    },
    {
      "id":14, "type":"gauge", "title":"RAM %",
      "gridPos":{"x":18,"y":17,"w":6,"h":5},
      "datasource":{"type":"prometheus","uid":"prometheus"},
      "targets":[{"expr":"sgp_nas_mem_pct{nas=\"$nas\"}","legendFormat":"RAM"}],
      "options":{"reduceOptions":{"calcs":["lastNotNull"]},"orientation":"auto","showThresholdLabels":true,"showThresholdMarkers":true},
      "fieldConfig":{
        "defaults":{
          "color":{"mode":"thresholds"},"unit":"percent","min":0,"max":100,
          "thresholds":{"mode":"absolute","steps":[{"color":"green","value":0},{"color":"yellow","value":75},{"color":"red","value":90}]}
        }
      }
    },

    {
      "id":15, "type":"timeseries", "title":"DHCP Clientes Ativos ao Longo do Tempo",
      "gridPos":{"x":0,"y":22,"w":16,"h":7},
      "datasource":{"type":"prometheus","uid":"prometheus"},
      "targets":[
        {"expr":"sgp_nas_dhcp_active{nas=\"$nas\"}","legendFormat":"Ativos (Bound)"},
        {"expr":"sgp_nas_dhcp_total{nas=\"$nas\"}","legendFormat":"Total Leases"}
      ],
      "fieldConfig":{
        "defaults":{"custom":{"fillOpacity":15,"lineWidth":2,"spanNulls":true},"unit":"short"},
        "overrides":[
          {"matcher":{"id":"byName","options":"Ativos (Bound)"},"properties":[{"id":"color","value":{"mode":"fixed","fixedColor":"#73BF69"}}]},
          {"matcher":{"id":"byName","options":"Total Leases"},"properties":[{"id":"color","value":{"mode":"fixed","fixedColor":"#5794F2"}}]}
        ]
      },
      "options":{"tooltip":{"mode":"multi"},"legend":{"displayMode":"table","placement":"bottom","calcs":["mean","max","lastNotNull"]}}
    },
    {
      "id":16, "type":"timeseries", "title":"Temperatura ao Longo do Tempo",
      "gridPos":{"x":16,"y":22,"w":8,"h":7},
      "datasource":{"type":"prometheus","uid":"prometheus"},
      "targets":[
        {"expr":"sgp_nas_temp_c{nas=\"$nas\",sensor=\"cpu\"}","legendFormat":"CPU °C"},
        {"expr":"sgp_nas_temp_c{nas=\"$nas\",sensor=\"board\"}","legendFormat":"Board °C"}
      ],
      "fieldConfig":{
        "defaults":{"custom":{"fillOpacity":10,"lineWidth":2,"spanNulls":true},"unit":"celsius"},
        "overrides":[
          {"matcher":{"id":"byName","options":"CPU °C"},"properties":[{"id":"color","value":{"mode":"fixed","fixedColor":"red"}}]},
          {"matcher":{"id":"byName","options":"Board °C"},"properties":[{"id":"color","value":{"mode":"fixed","fixedColor":"orange"}}]}
        ]
      },
      "options":{"tooltip":{"mode":"multi"},"legend":{"displayMode":"list","placement":"bottom"}}
    },

    { "id":17, "type":"row", "title":"🔌 Todas as Interfaces", "gridPos":{"x":0,"y":29,"w":24,"h":1}, "collapsed":true,
      "panels":[
        {
          "id":18, "type":"timeseries", "title":"RX por Interface (bytes/s)",
          "gridPos":{"x":0,"y":30,"w":12,"h":8},
          "datasource":{"type":"prometheus","uid":"prometheus"},
          "targets":[{"expr":"rate(sgp_nas_iface_rx_bytes{nas=\"$nas\"}[1m])","legendFormat":"⬇ {{iface}}"}],
          "fieldConfig":{"defaults":{"custom":{"fillOpacity":10,"lineWidth":1,"spanNulls":true},"unit":"Bps"}},
          "options":{"tooltip":{"mode":"multi","sort":"desc"},"legend":{"displayMode":"table","placement":"bottom","calcs":["mean","max"]}}
        },
        {
          "id":19, "type":"timeseries", "title":"TX por Interface (bytes/s)",
          "gridPos":{"x":12,"y":30,"w":12,"h":8},
          "datasource":{"type":"prometheus","uid":"prometheus"},
          "targets":[{"expr":"rate(sgp_nas_iface_tx_bytes{nas=\"$nas\"}[1m])","legendFormat":"⬆ {{iface}}"}],
          "fieldConfig":{"defaults":{"custom":{"fillOpacity":10,"lineWidth":1,"spanNulls":true},"unit":"Bps"}},
          "options":{"tooltip":{"mode":"multi","sort":"desc"},"legend":{"displayMode":"table","placement":"bottom","calcs":["mean","max"]}}
        }
      ]
    }
  ]
}
